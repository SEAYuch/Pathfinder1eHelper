<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Pathfinder1eHelper.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows the system theme variant. "Dark" or "Light" force one. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 分隔线（细灰）：Fluent 主题不直接提供该语义色，故在此按明暗主题自定 -->
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#E0E0E0" />
                    <!-- 错误提示红 -->
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#383838" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#FF8080" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- FluentAvaloniaTheme：WinUI3 风格主题（与 DdraigBench 一致）；基础主题只放这一个 -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <!-- DataGrid 属控件自带主题，需显式引入 -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>
</Application>
