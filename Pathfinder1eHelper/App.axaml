<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Pathfinder1eHelper.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows the system theme variant. "Dark" or "Light" force one. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Arc SpaceN tokens are Double values for Spacing properties, not Thickness. Keep typed
                 equivalents for Avalonia Margin/Padding so DynamicResource never assigns Double to Thickness. -->
            <Thickness x:Key="ArcSpace1Thickness">4</Thickness>
            <Thickness x:Key="ArcSpace2Thickness">8</Thickness>
            <Thickness x:Key="ArcSpace3Thickness">12</Thickness>
            <Thickness x:Key="ArcSpace4Thickness">16</Thickness>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 应用分隔线语义色：按明暗主题自定 -->
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#E0E0E0" />
                    <!-- 错误提示红 -->
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppDividerBrush" Color="#383838" />
                    <SolidColorBrush x:Key="AppDangerBrush" Color="#FF8080" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Avalonia 官方 FluentTheme 作为原生控件的过渡基础样式；Arc 控件主题由 UseArc 注册。 -->
        <fluent:FluentTheme />
    </Application.Styles>
</Application>
