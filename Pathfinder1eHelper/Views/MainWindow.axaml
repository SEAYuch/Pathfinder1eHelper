<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pathfinder1eHelper.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:ic="using:FluentIcons.Avalonia.Fluent"
        xmlns:reactive="using:ReactiveUI.Avalonia"
        xmlns:views="using:Pathfinder1eHelper.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Pathfinder1eHelper.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static vm:MainWindowViewModel.Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- FluentAvalonia 标准导航：左侧可折叠 pane（紧凑/展开由 NavigationView 管理），Content 区承载当前页 -->
    <!-- PaneDisplayMode=Auto：宽度 ≥ ExpandedModeThresholdWidth 展开，否则收缩为图标态（CompactPaneLength） -->
    <ui:FANavigationView PaneDisplayMode="Auto"
                         ExpandedModeThresholdWidth="1024"
                         CompactModeThresholdWidth="0"
                         OpenPaneLength="220"
                         CompactPaneLength="48"
                         MenuItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}">

        <ui:FANavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
                <ui:FANavigationViewItem IsEnabled="{Binding IsEnabled}">
                    <ui:FANavigationViewItem.IconSource>
                        <ic:FluentIconSource Icon="{Binding Icon}" IconVariant="Regular" />
                    </ui:FANavigationViewItem.IconSource>
                    <ui:FANavigationViewItem.Content>
                        <TextBlock Text="{Binding Header}" FontSize="16" />
                    </ui:FANavigationViewItem.Content>
                </ui:FANavigationViewItem>
            </DataTemplate>
        </ui:FANavigationView.MenuItemTemplate>

        <!-- 内容区：ReactiveUI 路由，RoutedViewHost 依据 Router 当前 VM 解析并嵌入对应 View -->
        <reactive:RoutedViewHost Router="{Binding Router}">
            <reactive:RoutedViewHost.ViewLocator>
                <views:ViewLocator />
            </reactive:RoutedViewHost.ViewLocator>
        </reactive:RoutedViewHost>
    </ui:FANavigationView>

</Window>
