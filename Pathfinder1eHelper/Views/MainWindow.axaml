<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pathfinder1eHelper.ViewModels"
        xmlns:arc="using:TKCode.Arc"
        xmlns:reactive="using:ReactiveUI.Avalonia"
        xmlns:views="using:Pathfinder1eHelper.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Pathfinder1eHelper.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static vm:MainWindowViewModel.Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <arc:Sidebar x:Name="Navigation"
                     Grid.Column="0"
                     Label="应用导航"
                     Header="Pathfinder 1e"
                     ItemsSource="{Binding SidebarItems}"
                     SelectedKey="{Binding SelectedNavKey, Mode=TwoWay}"
                     ExpandedWidth="240"
                     ResizeMode="Push"
                     IsFilterVisible="False"
                     CollapseButtonText="折叠导航"
                     ExpandButtonText="展开导航" />

        <!-- 内容区继续使用既有 ReactiveUI 路由与显式 ViewLocator；Sidebar 只负责选择路由键。 -->
        <reactive:RoutedViewHost Grid.Column="1" Router="{Binding Router}">
            <reactive:RoutedViewHost.ViewLocator>
                <views:ViewLocator />
            </reactive:RoutedViewHost.ViewLocator>
        </reactive:RoutedViewHost>
    </Grid>

</Window>
