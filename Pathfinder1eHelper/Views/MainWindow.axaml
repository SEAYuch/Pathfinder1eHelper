<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pathfinder1eHelper.ViewModels"
        xmlns:afui="using:AvaloniaFluentUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Pathfinder1eHelper.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static vm:MainWindowViewModel.Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- AvaloniaFluentUI 标准导航：左侧可折叠 pane（紧凑/展开由 NavigationView 管理），Content 区承载当前页 -->
    <afui:NavigationView IsPaneOpen="{Binding IsNavExpanded}"
                         PaneDisplayMode="Left"
                         OpenPaneLength="220"
                         CompactPaneLength="48"
                         MenuItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}">

        <afui:NavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
                <afui:NavigationViewItem IsEnabled="{Binding IsEnabled}">
                    <afui:NavigationViewItem.IconSource>
                        <afui:SymbolIcon Symbol="{Binding Icon}" />
                    </afui:NavigationViewItem.IconSource>
                    <afui:NavigationViewItem.Content>
                        <TextBlock Text="{Binding Header}" FontSize="16" />
                    </afui:NavigationViewItem.Content>
                </afui:NavigationViewItem>
            </DataTemplate>
        </afui:NavigationView.MenuItemTemplate>

        <!-- 内容区：页面切换由 ViewModel 的 CurrentPage 驱动 -->
        <TransitioningContentControl Content="{Binding CurrentPage}" />
    </afui:NavigationView>

</Window>
