<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pathfinder1eHelper.ViewModels.Pages"
             xmlns:vmc="using:Pathfinder1eHelper.ViewModels.Combat"
             xmlns:models="using:Pathfinder1eHelper.Models.Combat"
             xmlns:controls="using:Pathfinder1eHelper.Views.Controls"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="720"
             x:Class="Pathfinder1eHelper.Views.Pages.CombatView"
             x:DataType="vm:CombatViewModel">

    <UserControl.Styles>
        <!-- 字段标签与 Arc 自身字段标签同规格：14 px（TypeSM）、medium、次要文字色。
             依据 docs/components/select.md「Anatomy」1：Label 为 14 px medium weight，"uses the same
             type size as the Input label"；此前这里用 TypeXS，导致自绘标签比 Arc 的 Select/Combobox 标签小一号。 -->
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <!-- 说明/提示文案：与 Arc 的 Description 同规格（12 px、次要色、换行）。 -->
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 区段标题比字段标签高一级：字段标签由 Arc 控件自己画（14 px / medium，见 select.md「Anatomy」1），
             标题这里用 TypeBase(16) + SemiBold，避免两者同号同重而分不出层级。 -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- 数值组成明细（战斗卡与武器卡共用）。缩进按“类型即布局”记在 Resource 里，无实际意义。 -->
        <DataTemplate x:Key="ContributionTemplate" x:DataType="models:Contribution">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space2}"
                  Opacity="{Binding RowOpacity}"
                  ToolTip.Tip="{Binding Note}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" FontFamily="Consolas" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:CombatViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource ArcSpace4Thickness}" Spacing="{arc:ArcDesignTokenResource Space3}">

            <!-- 1. 角色档案 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="角色档案" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                            <TextBlock Classes="field" Text="档案" VerticalAlignment="Center" />
                            <!-- 视觉标签由左边这行 TextBlock 提供（与「新建/复制/删除」同一行，保持紧凑）；
                                 Arc Combobox 的 Label 会显示在上方造成重复文案，故只保留无障碍名。 -->
                            <arc:Combobox AutomationProperties.Name="档案" ItemsSource="{Binding Characters}"
                                           DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedCharacter}" MinWidth="160" />
                            <arc:Button Content="新建" Command="{Binding NewCharacterCommand}" Variant="Primary" />
                            <arc:Button Content="复制" Command="{Binding DuplicateCharacterCommand}" Variant="Secondary" />
                            <arc:HoldToConfirm Label="按住以删除角色档案" ConfirmedLabel="已删除"
                                               Tone="Danger"
                                               AutomationProperties.Name="按住以删除当前角色档案"
                                               Confirmed="OnDestructiveActionConfirmed"
                                               Command="{Binding DeleteCharacterCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                            <TextBlock Classes="field" Text="名称" VerticalAlignment="Center" />
                            <arc:Input Text="{Binding Name}" MinWidth="180" Label="名称" IsLabelVisible="False" />
                        </StackPanel>
                        <TextBlock Text="{Binding SaveError}"
                                   Foreground="{arc:ArcDesignTokenResource Danger}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 2. 基础数值 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="基础数值" />

                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">

                        <arc:NumberField AutomationProperties.Name="力量" Label="力量" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding StrengthInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="敏捷" Label="敏捷" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding DexterityInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="体质" Label="体质" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding ConstitutionInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="智力" Label="智力" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding IntelligenceInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="感知" Label="感知" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding WisdomInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="魅力" Label="魅力" Minimum="1" Maximum="99" Step="1"
                                             Width="104" Value="{Binding CharismaInput.Value}" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                        <arc:NumberField AutomationProperties.Name="基本攻击加值（BAB）" Label="基本攻击加值（BAB）" Minimum="0" Maximum="40" Step="1" Width="168"
                                           Value="{Binding BaseAttackBonusInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="强韧基础" Label="强韧基础" Minimum="0" Maximum="40" Step="1" Width="104"
                                           Value="{Binding BaseFortitudeInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="反射基础" Label="反射基础" Minimum="0" Maximum="40" Step="1" Width="104"
                                           Value="{Binding BaseReflexInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="意志基础" Label="意志基础" Minimum="0" Maximum="40" Step="1" Width="104"
                                           Value="{Binding BaseWillInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="施法者等级" Label="施法者等级" Minimum="0" Maximum="40" Step="1" Width="104"
                                           Value="{Binding CasterLevelInput.Value}" />
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                            <arc:Select Label="施法属性" MinWidth="110"
                                        ItemsSource="{x:Static vmc:CombatOptions.Abilities}"
                                        DisplayMemberBinding="{Binding Display}"
                                        SelectedItem="{Binding SelectedCastingAbility}" />
                        </StackPanel>
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                            <arc:Select Label="体型" MinWidth="110"
                                        ItemsSource="{x:Static vmc:CombatOptions.Sizes}"
                                        DisplayMemberBinding="{Binding Display}"
                                        SelectedItem="{Binding SelectedSize}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                        <arc:Checkbox Content="限制 AC 敏捷加值" IsChecked="{Binding LimitDex}" AutomationProperties.Name="限制 AC 敏捷加值" />
                        <arc:NumberField AutomationProperties.Name="最大敏捷加值" Label="最大敏捷加值" Minimum="0" Maximum="40" Step="1" Width="148" IsEnabled="{Binding LimitDex}"
                                           Value="{Binding MaxDexBonusInput.Value}" />
                        <arc:Checkbox Content="超小型及以下用敏捷计算 CMB" IsChecked="{Binding UseDexForManeuvers}" AutomationProperties.Name="超小型及以下用敏捷计算 CMB" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. 战斗数值卡 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="战斗数值（展开查看明细）" />
                    <!-- 用 Arc 原生 ExpandableCard（不改控件），由面板给每张卡固定 220 的槽位：
                         卡片正好铺满槽位、多张并排，展开只长高不变宽，因此不会重排。 -->
                    <ItemsControl x:Name="StatCards" ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="220"
                                           ItemSpacing="{arc:ArcDesignTokenResource Space2}"
                                           LineSpacing="{arc:ArcDesignTokenResource Space2}"
                                           HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:StatCard">
                                <arc:ExpandableCard CollapsedWidth="220"
                                                    AutomationProperties.Name="{Binding Name}">
                                    <arc:ExpandableCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TotalDisplay}" FontWeight="Bold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                                        </StackPanel>
                                    </arc:ExpandableCard.Header>
                                    <ItemsControl ItemsSource="{Binding Contributions}"
                                                  ItemTemplate="{StaticResource ContributionTemplate}" />
                                </arc:ExpandableCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. 状态预设 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="状态预设（一键加入修饰，可再编辑/停用）" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:PresetViewModel">
                                <arc:Button Content="{Binding Name}" Command="{Binding ApplyCommand}"
                                        Margin="{DynamicResource ArcSpace2Thickness}" Variant="Secondary" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. 修饰明细 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                        <TextBlock Classes="section" Text="修饰明细" VerticalAlignment="Center" />
                        <arc:Button Content="添加修饰" Command="{Binding AddBonusCommand}" Variant="Primary" />
                        <arc:HoldToConfirm Label="按住以清空全部修饰条目" ConfirmedLabel="已清空"
                                           Tone="Danger"
                                           AutomationProperties.Name="按住以清空全部修饰条目"
                                           ToolTip.Tip="清空全部修饰条目（含手动条目）"
                                           Confirmed="OnDestructiveActionConfirmed"
                                           Command="{Binding ClearAllBonusesCommand}" />
                        <TextBlock Classes="hint" Text="同描述符取高/取低（正负各留一个）；无类型/闪避/种族/专长/减值求和"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl x:Name="BonusEntries" ItemsSource="{Binding Bonuses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:BonusEntryViewModel">
                                <Border Width="392" Margin="{DynamicResource ArcSpace2Thickness}" Padding="{DynamicResource ArcSpace2Thickness}"
                                        Background="{arc:ArcDesignTokenResource Surface}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderStrong}" BorderThickness="1.5"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Opacity="{Binding CardOpacity}">
                                    <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space1}">
                                            <arc:Checkbox IsChecked="{Binding IsEnabled}" AutomationProperties.Name="启用或停用此修饰条目" ToolTip.Tip="启用" />
                                            <arc:Input Grid.Column="1" Text="{Binding Name}" Placeholder="名称" Label="修饰名称" IsLabelVisible="False" />
                                            <arc:Button Grid.Column="2"
                                                        Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        Variant="Danger"
                                                        AutomationProperties.Name="删除修饰条目" />
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}"
                                                  IsEnabled="{Binding !IsRuleComputed}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="描述符" MinWidth="116"
                                                            ItemsSource="{x:Static vmc:CombatOptions.Descriptors}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding Descriptor}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="作用目标" MinWidth="130"
                                                            ItemsSource="{x:Static vmc:CombatOptions.CombatStats}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding Stat}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Combobox Label="属性" Placeholder="—" MinWidth="96"
                                                              IsEnabled="{Binding IsAbilityTarget}"
                                                              ItemsSource="{x:Static vmc:CombatOptions.Abilities}"
                                                              DisplayMemberBinding="{Binding Display}"
                                                              SelectedItem="{Binding Ability}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="叠加" MinWidth="104"
                                                            ItemsSource="{x:Static vmc:CombatOptions.StackModes}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding StackMode}" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding RuleHint}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" TextWrapping="Wrap"
                                                   IsVisible="{Binding IsRuleComputed}" />

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="数值（带符号）" />
                                                <arc:NumberField AutomationProperties.Name="数值（带符号）" IsLabelVisible="False" Minimum="-99" Maximum="99" Step="1" Width="120" IsEnabled="{Binding !IsRuleComputed}"
                                           Value="{Binding ValueInput.Value}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="备注/来源" />
                                                <arc:Input Width="220" Text="{Binding Notes}" Placeholder="备注/来源" Label="备注/来源" IsLabelVisible="False" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 6. 减值换加值生成器：仅在点击添加时把两条普通修饰复制到修饰明细。 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="减值换加值" />
                    <TextBlock Classes="hint" Text="设置仅用于本次生成；点击添加后，会在修饰明细中加入两条可分别编辑、启停和删除的无类型修饰。" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                        <arc:Input Width="180" Text="{Binding ExchangeEntryName, Mode=TwoWay}"
                                     Placeholder="减值换加值" Label="词条名称" />
                        <arc:NumberField AutomationProperties.Name="减值幅度" Label="减值幅度（生成 −N）"
                                             Value="{Binding ExchangePenaltyInput}" Minimum="0" Maximum="11" Step="1"
                                             IsScrubEnabled="False" Width="180" />
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                            <arc:Select Label="减值来源" MinWidth="220"
                                        ItemsSource="{Binding PenaltySources}"
                                        DisplayMemberBinding="{Binding Display}"
                                        SelectedItem="{Binding SelectedPenaltySource}" />
                        </StackPanel>
                        <!-- 原来是可编辑 ComboBox（预置倍率 + 自由输入）；Arc 没有「可自由输入的下拉」，
                             改为 Input + 就地错误提示：非法输入直接在框下标红，而不是悄悄点不动按钮。 -->
                        <arc:Input Width="200" Text="{Binding BonusMultiplierText, Mode=TwoWay}"
                                   Placeholder="例如 1.5"
                                   Label="加值倍率（0.5–10，每步 0.5）"
                                   ErrorMessage="{Binding BonusMultiplierError}" />
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                            <arc:Select Label="加值去处" MinWidth="180"
                                        ItemsSource="{Binding BonusDestinations}"
                                        DisplayMemberBinding="{Binding Display}"
                                        SelectedItem="{Binding SelectedBonusDestination}" />
                        </StackPanel>
                        <arc:Button Content="添加两条修饰" Command="{Binding AddPenaltyBonusCommand}" Variant="Primary"
                                IsEnabled="{Binding CanAddExchange}" VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ExchangeValidationError}" Foreground="{arc:ArcDesignTokenResource Danger}"
                               TextWrapping="Wrap" IsVisible="{Binding ExchangeValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <!-- 7. 武器 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                        <TextBlock Classes="section" Text="武器" VerticalAlignment="Center" />
                        <arc:Button Content="添加武器" Command="{Binding AddWeaponCommand}" Variant="Primary" />
                        <TextBlock Classes="field" Text="武器预设：" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding WeaponPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:PresetViewModel">
                                <arc:Button Content="{Binding Name}" Command="{Binding ApplyCommand}"
                                        Margin="{DynamicResource ArcSpace2Thickness}" Variant="Secondary" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="Weapons" ItemsSource="{Binding Weapons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmc:WeaponViewModel">
                                <Border Width="452" Margin="{DynamicResource ArcSpace2Thickness}" Padding="{DynamicResource ArcSpace2Thickness}"
                                        Background="{arc:ArcDesignTokenResource Surface}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderStrong}" BorderThickness="1.5"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                                    <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space1}">
                                            <arc:Input Text="{Binding Name}" Placeholder="武器名" Label="武器名" IsLabelVisible="False" />
                                            <arc:HoldToConfirm Grid.Column="1"
                                                                Label="按住以删除此武器"
                                                                ConfirmedLabel="已删除"
                                                                Tone="Danger"
                                                                HoldDuration="00:00:01.2"
                                                                AutomationProperties.Name="按住以删除此武器"
                                                                Confirmed="OnDestructiveActionConfirmed"
                                                                Command="{Binding RemoveCommand}" />
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}">
                                            <arc:Button Content="＋武器专攻" Command="{Binding AddWeaponFocusCommand}" Variant="Secondary" Size="Small"
                                                    ToolTip.Tip="攻击 +1（仅本武器，描述符 无类型可叠加）" />
                                            <arc:Button Content="＋武器专精" Command="{Binding AddWeaponSpecializationCommand}" Variant="Secondary" Size="Small"
                                                    ToolTip.Tip="伤害 +2（仅本武器，描述符 无类型可叠加）" />
                                        </WrapPanel>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="攻击方式" MinWidth="96"
                                                            ItemsSource="{x:Static vmc:CombatOptions.WeaponAttackTypes}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding AttackType}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="持握" MinWidth="104"
                                                            ItemsSource="{x:Static vmc:CombatOptions.WeaponHands}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding Hand}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Combobox Label="命中属性（可空=自动）" Placeholder="自动" MinWidth="104"
                                                              ItemsSource="{x:Static vmc:CombatOptions.Abilities}"
                                                              DisplayMemberBinding="{Binding Display}"
                                                              SelectedItem="{Binding AttackBonusStat}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Combobox Label="伤害属性（可空=自动）" Placeholder="自动" MinWidth="104"
                                                              ItemsSource="{x:Static vmc:CombatOptions.Abilities}"
                                                              DisplayMemberBinding="{Binding Display}"
                                                              SelectedItem="{Binding DamageBonusStat}" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="伤害骰" />
                                                <arc:Input Width="76" Text="{Binding BaseDamage}" Placeholder="伤害骰" Label="伤害骰" IsLabelVisible="False" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="增强" />
                                                <arc:NumberField AutomationProperties.Name="增强加值" IsLabelVisible="False" Minimum="0" Maximum="10" Step="1" Width="76"
                                           Value="{Binding EnhancementInput.Value}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="威胁下限" />
                                                <arc:NumberField AutomationProperties.Name="重击威胁下限" IsLabelVisible="False" Minimum="1" Maximum="20" Step="1" Width="80"
                                           Value="{Binding CriticalThreatLowInput.Value}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="重击倍率" />
                                                <arc:NumberField AutomationProperties.Name="重击倍率" IsLabelVisible="False" Minimum="2" Maximum="4" Step="1" Width="80"
                                           Value="{Binding CriticalMultiplierInput.Value}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="副手" />
                                                <arc:Checkbox Content="副手" IsChecked="{Binding IsSecondary}" AutomationProperties.Name="副手" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="武器分类" MinWidth="96"
                                                            ItemsSource="{x:Static vmc:CombatOptions.WeaponCategories}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding Category}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="双头" />
                                                <arc:Checkbox Content="双头" IsChecked="{Binding IsDouble}" AutomationProperties.Name="双头" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space2}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <arc:Select Label="武器体型" MinWidth="96"
                                                            ItemsSource="{x:Static vmc:CombatOptions.Sizes}"
                                                            DisplayMemberBinding="{Binding Display}"
                                                            SelectedItem="{Binding WeaponSize}" />
                                            </StackPanel>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="体型偏移（±档）" />
                                                <arc:NumberField AutomationProperties.Name="伤害骰体型偏移" IsLabelVisible="False" Minimum="-2" Maximum="2" Step="1" Width="86"
                                           Value="{Binding DamageDiceSizeShiftInput.Value}" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <Border Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space4}">
                                            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                                                <TextBlock Classes="field" Text="攻击" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FullAttackDisplay}" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                                                <TextBlock Classes="field" Text="伤害" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DamageDisplay}" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                                                <TextBlock Classes="field" Text="重击" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CriticalDisplay}" FontWeight="Bold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <arc:ExpandableCard Margin="{DynamicResource ArcSpace1Thickness}"
                                                            AutomationProperties.Name="攻击与伤害组成明细">
                                            <arc:ExpandableCard.Header>
                                                <TextBlock Text="明细（攻击 / 伤害组成）" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </arc:ExpandableCard.Header>
                                            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                                                <TextBlock Classes="field" Text="攻击组成" />
                                                <ItemsControl ItemsSource="{Binding AttackContributions}"
                                                              ItemTemplate="{StaticResource ContributionTemplate}" />
                                                <TextBlock Classes="field" Text="伤害组成" />
                                                <ItemsControl ItemsSource="{Binding DamageContributions}"
                                                              ItemTemplate="{StaticResource ContributionTemplate}" />
                                            </StackPanel>
                                        </arc:ExpandableCard>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 8. 专注检定 -->
            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1.25"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" Padding="{DynamicResource ArcSpace3Thickness}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Classes="section" Text="专注检定" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="{arc:ArcDesignTokenResource Space3}" LineSpacing="{arc:ArcDesignTokenResource Space2}">
                        <arc:NumberField AutomationProperties.Name="法术环位" Label="法术环位" Minimum="0" Maximum="9" Step="1" Width="104"
                                           Value="{Binding SpellLevelInput.Value}" />
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                            <arc:Select Label="情境" MinWidth="250"
                                        ItemsSource="{x:Static vmc:CombatOptions.ConcentrationSituations}"
                                        DisplayMemberBinding="{Binding Display}"
                                        SelectedItem="{Binding SelectedConcentrationSituation}" />
                        </StackPanel>
                        <arc:NumberField AutomationProperties.Name="受到伤害" Label="受伤数值" Minimum="0" Maximum="999" Step="1" Width="104" IsEnabled="{Binding IsDamageMode}"
                                           Value="{Binding DamageTakenInput.Value}" />
                        <arc:NumberField AutomationProperties.Name="自定义 DC" Label="自定义 DC" Minimum="0" Maximum="99" Step="1" Width="104" IsEnabled="{Binding IsCustomDc}"
                                           Value="{Binding CustomDcInput.Value}" />
                        <TextBlock Text="{Binding ConcentrationCheckDisplay}" FontWeight="Bold"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}" VerticalAlignment="Bottom" Margin="{DynamicResource ArcSpace1Thickness}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="提示：修饰条目可随时停用（取消勾选）；被同描述符更高/更低者压制时，会在数值卡中以半透明显示。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
