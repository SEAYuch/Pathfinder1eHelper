<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- xunit.v3 要求测试工程可执行 -->
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- xUnit1051 为“传入 TestContext.Current.CancellationToken”的样式提示，非正确性问题，统一关闭以保持零告警 -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <!-- xunit.v3（支持 VSTest 与 MTP 双通道）；此处走 VSTest：dotnet test 在 .NET 10 MTP 服务器模式下与 xunit.v3 4.0.1 不兼容 -->
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pathfinder1eHelper\Pathfinder1eHelper.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Copy the reference DB so the smoke test resolves it at AppContext.BaseDirectory\data (same as the app). -->
        <None Include="..\data\pathfinder1e.duckdb" Link="data\pathfinder1e.duckdb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
