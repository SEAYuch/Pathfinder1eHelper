<Project>
  <PropertyGroup>
    <!-- 统一告警策略：告警即错误，保证主干零告警。
         分析器级别使用 SDK 默认（latest），不额外上调到 latest-recommended：
         后者会引入大量本地化/性能类规则（CA1305/CA1304/CA1859 等），对本应用收益低。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 单一版本源。改版本号只改这一处，勿在 csproj 里另写 <Version>。
       <Version> 会被 SDK 派生成程序集四件套：
         AssemblyVersion 0.1.0.0 / FileVersion 0.1.0.0 / InformationalVersion 0.1.0
       （InformationalVersion 才是运行期对外展示与写入 db_info 的那个，见 AppInfo；
         注意 SDK 会给它追加 "+<commit>" 的 SemVer 元数据后缀，AppInfo 会剥掉）。 -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <!-- 打包用：不含元数据的纯 SemVer 主体，供 Velopack / WiX / 后续 MSIX 取值。 -->
    <VersionPrefix>$(Version)</VersionPrefix>
    <!-- 发行元数据：写进 exe 的「属性 → 详细信息」，也由 AppInfo.ProductName 读取，
         使代码与安装包/资源管理器显示的产品名同源。 -->
    <Product>Pathfinder 1e中文助手</Product>
  </PropertyGroup>
</Project>
